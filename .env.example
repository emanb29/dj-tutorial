# Copy to .env at the project root (gitignored). Every variable is optional; the API and Vite read
# this file, and values already in the environment win over it. AGENTS.md describes each one.

# Coach: unset = no-key mode, where the built-in deterministic Coach answers everything.
ANTHROPIC_API_KEY=
# COACH_MONTHLY_CAP_USD=5
# COACH_LOG_PAYLOADS=0

# Remote access: host names a reverse proxy or tunnel serves the app at over HTTPS, comma-separated.
# Vite accepts them and the API allows https://<host>.
# PUBLIC_HOSTS=dj.example.com

# ALLOWED_ORIGINS replaces the default list (the dev app, the e2e preview and each public host).
# ALLOWED_ORIGINS=http://127.0.0.1:5179

# API_HOST=127.0.0.1
# API_PORT=5180
# DATA_DIR=.local/data
# ORIGINALS_DIR=.local/tracks/originals
# MAX_LEARNERS=16
